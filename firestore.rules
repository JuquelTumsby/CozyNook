rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's saved progress: only they can read or write it.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // The shared park ("Outside"). Signed-in players can see everyone there,
    // but can only change their own spot. No free text is allowed: names are
    // two numbers (turned into words like "Sunny Otter") and phrases are numbers.
    match /explore/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['x', 'y', 'look', 'na', 'nb', 'say', 'sayAt', 'emo', 'emoAt', 'hopAt', 'to', 'seen'])
        && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 480
        && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 270
        && request.resource.data.na is int && request.resource.data.na >= 0 && request.resource.data.na < 32
        && request.resource.data.nb is int && request.resource.data.nb >= 0 && request.resource.data.nb < 32
        && request.resource.data.say is int && request.resource.data.say >= -1 && request.resource.data.say <= 12
        && request.resource.data.emo is string && request.resource.data.emo.size() <= 10
        && request.resource.data.to is string && request.resource.data.to.size() <= 40
        && request.resource.data.look is map && request.resource.data.look.size() <= 8
        && request.resource.data.seen is int;
    }
  }
}
